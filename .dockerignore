# VCS / IDE
.git
.gitignore
.cursor
.vscode
.idea
.Rproj.user
*.Rhistory
.Rhistory

# Python
__pycache__
*.py[cod]
*$py.class
.pytest_cache
venv
.env
.env.*
!.env.example

# Large project trees (keep API image small).
#
# data/ is excluded by default — except the two subtrees the operational
# FastAPI service requires at runtime:
#   * data/ad_models/<lane>/ad_model.json  (per-lane AD decisions)
#   * data/config/{ucmr_analyte_limits_ngl,matrix_pipeline_sop}.csv
#
# Negation must un-ignore both the directory entry and its contents (Docker
# build context quirk). Order matters: parents before children.
data
!data/ad_models
!data/ad_models/**
!data/config
!data/config/**
!data/reference
!data/reference/registry
!data/reference/registry/reference_registry.csv

legacy
results
tools
validation
.terraform

# Local / Shiny / DB artifacts not used by the API image
*.sqlite
LatestPFAS.R

# Bulk downloads & training artifacts often present locally
**/UCMR5_*
**/epa_ucmr5
**/epa_icis_npdes

# --- include governed reference + release evidence in image context ---
!data/reference/**
!data/training
!data/training/matrix_pipeline_summary.json
!data/training/pfas_training_target_progress.json
!data/training/ucmr_exceedance_manifest.json

!validation/
!validation/releases/
!validation/releases/governed-v1.1.0/
!validation/releases/governed-v1.1.0/**

!results/
!results/reference_pack_manifest.json
!results/nist_reference_validation_report.json
!results/nist_reference_validation_summary.txt
