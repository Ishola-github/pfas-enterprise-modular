APP_ENV=development
SCREENING_USE_ONLY=true
COST_PER_LAB_ANALYSIS_USD=350
KG_CO2_PER_SAMPLE=2.5
PORT=8000

# PostgreSQL when persistence is enabled (Render injects in production)
DATABASE_URL=postgresql://user:password@localhost:5432/pfas_enterprise

# -- PFAS Enterprise 5 operational API (api/) ----------------------------
# All values below are SAFE EXAMPLES. Generate real secrets locally
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`) and
# do NOT commit a populated .env. Only .env.example is committed.

# Comma-separated API keys. Either "secret" or "id:secret" form.
#   PFAS_API_KEYS=ops:CHANGE_ME_TO_A_REAL_SECRET,ci:ANOTHER_SECRET
# Leaving this blank in development mode prints a one-shot generated dev key.
PFAS_API_KEYS=

# If true, every request is accepted with no header (DEV LOOPBACK ONLY).
# Set explicitly to "false" in any staging / production environment.
PFAS_API_AUTH_OPEN=false

# Header that carries the API key (case-insensitive in HTTP).
PFAS_API_AUTH_HEADER=X-API-Key

# Per-key token bucket (in-process; not distributed).
PFAS_API_RATE_LIMIT_ENABLED=true
PFAS_API_RATE_LIMIT_PER_MINUTE=60
PFAS_API_RATE_LIMIT_BURST=20

# Structured access logs (one JSON object per line).
PFAS_API_LOG_LEVEL=INFO
PFAS_API_LOG_JSON=true
# Optional file sink in addition to stdout:
# PFAS_API_ACCESS_LOG=logs/api_access.jsonl

# Applicability-domain refusal behaviour.
# When true (default), AD reject -> HTTP 422 with full AD context.
# When false, HTTP 200 is returned with prediction_refused=true.
PFAS_API_AD_STRICT_REFUSAL=true

# Health endpoint internal-path exposure (off by default).
PFAS_API_EXPOSE_PATHS=false

# Request-id header (clients can supply their own; the API echoes it back).
PFAS_API_REQUEST_ID_HEADER=X-Request-Id

# Exploratory only: set to 1 to allow multiple matrix pipeline lanes in one
# pfas_multisource_training.csv (bypasses SOP §6 merge guard in prepare_multisource_training.R).
# PFAS_ALLOW_MULTISOURCE_MERGE=1
