{
  "ontology_id": "pfos_pfoa_v1_1",
  "ontology_version": "1.1.1",
  "issued": "2026-05-17",
  "status": "frozen",
  "scope": {
    "matrix": "human_serum",
    "matrix_isolation": "human_serum_only",
    "analyte_family": ["PFOA", "PFOS"],
    "isomer_resolution": "all_four_isomer_columns",
    "concentration_units": "ng/mL",
    "source_program": "CDC NHANES",
    "anchor_cycle": "J (2017-2018)",
    "anchor_governance_directory": "validation/serum_v1",
    "anchor_csv_path": "data/training/serum/nhanes_serum_pfas_2017_2018.csv",
    "anchor_csv_sha256": "dfd4dbb59128043e91870265acc15f91f673ec81ee3d00d91223022755e4490f",
    "reference_table_path": "data/reference_tables/nhanes_pfas_weighted_reference_tables_v1_1.csv",
    "reference_table_sha256": "fe195d6206d98d1e2281213fdc937dace468b57f9f8518bfca0e3496d0ba8f19",
    "default_reference_cycle": "J",
    "reference_cycles_available": ["I", "J", "P"],
    "demographic_strata": ["sex", "age_group", "race_ethnicity"],
    "lod_policy": {
      "input_lod_code_column": "lod_code",
      "below_lod_values": "NHANES stores LOD/sqrt(2) in result_value when lod_code=1",
      "report_flags": [
        "input_reported_below_lod",
        "query_at_or_below_imputed_lod",
        "reference_stratum_lod_dominated"
      ]
    },
    "race_ethnicity_source": "NHANES DEMO RIDRETH3",
    "race_ethnicity_labels": [
      "mexican_american",
      "other_hispanic",
      "nh_white",
      "nh_black",
      "nh_asian",
      "other",
      "hispanic",
      "all"
    ],
    "race_strata_policy": {
      "min_n_unweighted": 20,
      "hispanic_collapse": "RIDRETH3 codes 1 (Mexican American) and 2 (Other Hispanic) -> hispanic",
      "reference_race_levels": ["all", "hispanic", "nh_white", "nh_black", "nh_asian", "other"],
      "report_granular_requested": true,
      "report_lookup_label": true,
      "report_fallback_flag": true
    }
  },
  "intent": "Contextualize serum PFOS/PFOA against weighted NHANES reference distributions with sex, age, and race/ethnicity strata when provided. Refusal-first, provenance-logged. Not diagnostic, not clinical, not regulatory.",
  "required_input_columns": {
    "sample_matrix":  {"role": "matrix_assertion", "expected_value": "human_serum"},
    "result_unit":    {"role": "unit_assertion", "expected_value": "ng/mL"},
    "source_program": {"role": "source_assertion", "expected_value": "CDC NHANES"},
    "analyte":        {"role": "analyte_id_pointer", "expected_value_in": "analytes[].analyte_id"},
    "result_value":   {"role": "numeric_concentration", "dtype": "float64", "nullable": false}
  },
  "optional_input_columns": {
    "sex":             {"role": "demographic_sex", "dtype": "int", "maps_to": "male|female"},
    "age_years":       {"role": "demographic_age", "dtype": "int"},
    "race_ethnicity":  {"role": "demographic_race", "dtype": "string", "source": "RIDRETH3 or governed label"},
    "reference_cycle": {"role": "nhanes_cycle", "allowed": ["I", "J", "P"]},
    "lod_code":        {"role": "below_lod_flag", "dtype": "int", "allowed": [0, 1, null]},
    "sample_weight":   {"role": "row_weight", "dtype": "float64"}
  },
  "analytes": [
    {
      "analyte_id": "n_pfoa",
      "analyte_label": "n-PFOA (linear PFOA)",
      "analyte_family": "PFOA",
      "isomer_class": "linear",
      "units": "ng/mL",
      "reference_value_column": "lbxnfoa",
      "reference_lod_code_column": "lbdnfoal",
      "below_lod_imputation": "LOD/sqrt(2) (NHANES rule, recorded in reference column)"
    },
    {
      "analyte_id": "sb_pfoa",
      "analyte_label": "Sb-PFOA (sum branched PFOA)",
      "analyte_family": "PFOA",
      "isomer_class": "branched_sum",
      "units": "ng/mL",
      "reference_value_column": "lbxbfoa",
      "reference_lod_code_column": "lbdbfoal",
      "below_lod_imputation": "LOD/sqrt(2) (NHANES rule, recorded in reference column)",
      "interpretation_caveat": "High below-LOD fractions: central percentiles may reflect NHANES imputation, not population signal."
    },
    {
      "analyte_id": "n_pfos",
      "analyte_label": "n-PFOS (linear PFOS)",
      "analyte_family": "PFOS",
      "isomer_class": "linear",
      "units": "ng/mL",
      "reference_value_column": "lbxnfos",
      "reference_lod_code_column": "lbdnfosl",
      "below_lod_imputation": "LOD/sqrt(2) (NHANES rule, recorded in reference column)"
    },
    {
      "analyte_id": "sm_pfos",
      "analyte_label": "Sm-PFOS (sum branched PFOS)",
      "analyte_family": "PFOS",
      "isomer_class": "branched_sum",
      "units": "ng/mL",
      "reference_value_column": "lbxmfos",
      "reference_lod_code_column": "lbdmfosl",
      "below_lod_imputation": "LOD/sqrt(2) (NHANES rule, recorded in reference column)"
    }
  ],
  "refusal_catalog": [
    {
      "code": "matrix_not_serum",
      "trigger": "sample_matrix != 'human_serum'",
      "human_text": "Input matrix is not human_serum. V1 is serum-only by contract."
    },
    {
      "code": "analyte_not_in_pfos_pfoa_scope",
      "trigger": "analyte not in {n_pfoa, sb_pfoa, n_pfos, sm_pfos}",
      "human_text": "Analyte is not in the V1 PFOS/PFOA scope."
    },
    {
      "code": "missing_units",
      "trigger": "result_unit is null or empty",
      "human_text": "Missing required unit declaration."
    },
    {
      "code": "units_not_ng_per_mL",
      "trigger": "result_unit != 'ng/mL'",
      "human_text": "Unit is not ng/mL."
    },
    {
      "code": "missing_source_program",
      "trigger": "source_program is null or empty",
      "human_text": "Missing required source_program declaration."
    },
    {
      "code": "missing_result_value",
      "trigger": "result_value is null or non-numeric",
      "human_text": "Missing or non-numeric result_value."
    },
    {
      "code": "reference_table_drifted",
      "trigger": "sha256(reference_table) != expected reference_table_sha256",
      "human_text": "Weighted reference table SHA-256 drifted."
    },
    {
      "code": "reference_anchor_drifted",
      "trigger": "sha256(anchor_csv) != expected anchor_csv_sha256",
      "human_text": "Cycle-J anchor CSV SHA-256 drifted."
    },
    {
      "code": "reference_stratum_missing",
      "trigger": "no precomputed row for (cycle, analyte_id, sex, age_group, race_ethnicity)",
      "human_text": "Requested reference stratum is not in the precomputed V1.1 table."
    }
  ],
  "non_claims": [
    "V1 does not return a diagnosis.",
    "V1 does not return a clinical interpretation.",
    "V1 does not return a regulatory exposure determination.",
    "V1 does not return an exposure-risk prediction.",
    "V1 is not a toxicology AI.",
    "V1 is not a temporal-trend or cross-cycle comparison tool."
  ],
  "reproducibility": {
    "deterministic_replay": "Same input CSV, ontology JSON, weighted reference table, and code version yield the same output_hash.",
    "ontology_change_signal": "Editing this JSON changes ontology_hash and run_id."
  }
